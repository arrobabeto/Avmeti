{
  "mcpServers": {
    "orbitype-sql": {
      "type": "http",
      "url": "https://core.orbitype.com/api/mcp/v1",
      "headers": {
        "X-API-KEY": "${env:ORBITYPE_API_SQL_KEY}"
      }
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "${env:FIGMA_ACCESS_TOKEN}"
      }
    }
  }
}
